# Copy to .env and fill in. NEVER commit the real .env.

# Server
NODE_ENV=development
PORT=4000

# SQLite by default. For Postgres, set e.g.:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/leftbehind?schema=public"
# and change the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# JWT access-token signing secret. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET="replace-with-64+char-random-hex"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed origins for CORS. The mobile app (native)
# does not send an Origin header, so this mainly guards browser access.
# Example: http://localhost:8081,http://localhost:19006
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Max upload size for encrypted sync blobs + document images.
MAX_BODY_SIZE=25mb
