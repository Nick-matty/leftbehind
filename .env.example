# ============================================================================
# LeftBehind — environment template
#
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# Values marked PUBLIC may be shipped in client bundles; everything else must
# stay server-side (Supabase function secrets or your host's env store).
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# PUBLIC — safe in web/mobile bundles (RLS is the real gate).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"

# PRIVATE — Edge Functions / admin scripts only. Never in a client build.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Vite only exposes VITE_* to the browser bundle.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
# Android SDK key — restrict to package name + release SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY="<android-key>"
# iOS SDK key — restrict to bundle id com.leftbehind.app.
GOOGLE_MAPS_IOS_API_KEY="<ios-key>"
# Browser key for Maps JS — restrict by HTTP referrer.
VITE_GOOGLE_MAPS_JS_API_KEY="<web-maps-key>"
# PRIVATE — server-side Places/Geocoding calls made by the places-proxy function.
GOOGLE_PLACES_SERVER_KEY="<server-key>"

# ---------------------------------------------------------------------------
# Push notifications (Phase 6; server-side only)
# ---------------------------------------------------------------------------
FCM_PROJECT_ID="<firebase-project-id>"
FCM_CLIENT_EMAIL="<service-account-email>"
FCM_PRIVATE_KEY="<service-account-private-key>"
APNS_KEY_ID="<apple-key-id>"
APNS_TEAM_ID="<apple-team-id>"
APNS_PRIVATE_KEY="<p8-contents>"
APNS_BUNDLE_ID="com.leftbehind.app"

# ---------------------------------------------------------------------------
# Local / client options
# ---------------------------------------------------------------------------
# Web app origin used for auth redirect links.
APP_ORIGIN="http://localhost:5173"
# 5173 = web, 5174 = admin
VITE_APP_ENV="development"
