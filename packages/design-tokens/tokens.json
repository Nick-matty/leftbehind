        "danger": "#B3362F",
        "info": "#2B6CB0",
        "star": "#B07C22",
        "overlayScrimStart": "rgba(8,16,20,0)",
        "overlayScrimEnd": "rgba(8,16,20,0.72)"
      },
      "dark": {
        "bg": "#0E1319",
        "bgSunken": "#0A0E13",
