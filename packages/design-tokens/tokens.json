    "chart": ["#16806F", "#C5673D", "#2B6CB0", "#B07C22", "#66737F", "#2E9E8D"]
  },
  "typography": {
    "family": {
      "display": "Fraunces",
      "ui": "Inter",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display.lg": { "sizeRem": 3, "lineRem": 3.5, "weight": 600, "tracking": "-0.02em", "family": "display" },
      "display.md": { "sizeRem": 2.25, "lineRem": 2.75, "weight": 600, "tracking": "-0.02em", "family": "display" },
      "display.sm": { "sizeRem": 1.75, "lineRem": 2.25, "weight": 600, "tracking": "-0.015em", "family": "display" },
      "title.lg": { "sizeRem": 1.375, "lineRem": 1.875, "weight": 600, "tracking": "-0.01em", "family": "display" },
      "title.md": { "sizeRem": 1.125, "lineRem": 1.625, "weight": 600, "tracking": "0", "family": "ui" },
      "body.lg": { "sizeRem": 1.0625, "lineRem": 1.625, "weight": 400, "tracking": "0", "family": "ui" },
      "body.md": { "sizeRem": 0.9375, "lineRem": 1.5, "weight": 400, "tracking": "0", "family": "ui" },
      "body.sm": { "sizeRem": 0.8125, "lineRem": 1.25, "weight": 400, "tracking": "0", "family": "ui" },
      "label": { "sizeRem": 0.8125, "lineRem": 1.125, "weight": 500, "tracking": "0.01em", "family": "ui" },
      "overline": { "sizeRem": 0.6875, "lineRem": 1, "weight": 600, "tracking": "0.08em", "family": "ui", "transform": "uppercase" }
    }
  },
  "space": {
    "0": 0,
    "px": 1,
    "0.5": 2,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "layout": {
    "gutter": { "mobile": 16, "tablet": 24, "desktop": 48 },
    "sectionRhythm": { "mobile": 32, "desktop": 48 },
    "contentMaxWidth": 1200,
    "proseMaxWidth": 680,
    "adminSidebarWidth": 240,
    "adminSidebarCollapsedWidth": 64
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 20,
    "full": 999
  },
  "border": {
    "hairline": 1,
    "focus": 2
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 21, 28, 0.06)",
    "md": "0 4px 12px rgba(16, 21, 28, 0.08)",
    "lg": "0 12px 32px rgba(16, 21, 28, 0.12)",
    "none": "none"
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "moderate": 260, "slow": 400 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 0, 1)"
    },
    "spring": { "sheet": { "stiffness": 260, "damping": 28 } },
    "staggerMs": 40
  },
  "size": {
    "controlHeight": { "mobile": 48, "web": 44 },
    "controlHeightSm": 36,
    "icon": { "sm": 16, "md": 20, "lg": 24, "xl": 28 },
    "avatar": { "xs": 24, "sm": 32, "md": 40, "lg": 64 },
    "touchTargetMin": 44,
    "bottomNavHeight": 56,
    "topBarHeight": 56,
    "mapMarker": 32,
    "mapMarkerSelected": 40,
    "dialogMaxWidth": 480,
    "adminTableRowHeight": 40
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "overlay": 100,
    "sheet": 200,
    "modal": 300,
    "toast": 400
  }
}
